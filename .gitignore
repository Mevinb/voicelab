# --- Personal & generated data: NEVER commit ---
# Your own voice notes / reference clips (private!)
samples/
# Generated audio, UI logs, job temp dirs
outputs/
# Downloaded model weights (~GBs, auto-fetched on first run)
checkpoints/
# Saved reference voices (private!)
voices/

# --- Heavy third-party components (recreated by ./setup.sh) ---
# Seed-VC upstream clone (GPL-3.0, pinned in setup.sh)
seed-vc/
# Chatterbox virtualenv + its cache
chatterbox/
# Project-local uv cache (only used when the global one is on another disk)
.uv-cache/

# --- Environment & logs ---
.env*
*.log

# --- Python cruft ---
__pycache__/
*.py[cod]
*.egg-info/
.venv*/
venv/
.ruff_cache/
.pytest_cache/

# --- OS/editor ---
.DS_Store
*.swp
.idea/
.vscode/
